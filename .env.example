# Backend only. Copy this file to .env at the repository root.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000

# PostgreSQL connection for the backend only.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional frontend key; the locations backend does not use this.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Required for GET /locations. Use your backend secret (sb_secret_) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
