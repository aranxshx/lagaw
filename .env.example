# frontend

# Cloudflare Pages deploys via Wrangler (DevOps). CI reads these from its secret store;
# set them here only to deploy by hand. Never commit real values.
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_edit_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# backend

# Hosted structured preference extraction (backend only).
# Get a key from https://platform.deepseek.com/; never commit a real key.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official API ID currently serving DeepSeek-V4.1-Flash.
DEEPSEEK_MODEL=deepseek-flash
