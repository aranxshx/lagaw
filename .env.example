# Backend only. Copy this file to .env at the repository root.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000

# Cloudflare Pages deploys via Wrangler (DevOps). CI reads these from GitHub Actions secrets;
# set them here only to deploy by hand. Never commit real values.
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_edit_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# PostgreSQL connection for the backend only.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Reserved; the locations backend does not use this. Flutter calls FastAPI, not Supabase.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Required for GET /locations. Use your backend secret (sb_secret_) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Backend CORS: exact frontend origins, separated by commas, with no trailing slash.
# Local Flutter Web uses a fixed port: flutter run -d chrome --web-port 3000
# On the backend host, replace these with the actual HTTPS frontend origin(s).
# Unset/empty permits no cross-origin browser reads. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
